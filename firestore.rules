rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// GroundEd — Firestore security rules
//
// Design notes (disclosed in the README as part of the submission):
//   • Sessions are readable by anyone holding the join code — classroom quiz
//     content is not sensitive. Submissions require (anonymous) auth and are
//     immutable after creation — students can never edit results retroactively.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{code} {
      // Session docs carry the quiz content students need to join by code —
      // classroom quiz content is not sensitive, so join-by-code stays open.
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid
                    && code is string
                    && code.size() >= 5 && code.size() <= 16;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;

      match /submissions/{studentId} {
        // v2: submissions (children's names + answers) now require
        // authentication to read. Students anonymous-sign-in before joining
        // anyway, so the classroom flow is unchanged — but unauthenticated
        // enumeration of live sessions is now impossible.
        allow read: if request.auth != null;
        // Students anonymous-sign-in before submitting (see StudentView), so
        // requiring auth costs nothing and blocks unauthenticated spam.
        allow create: if request.auth != null
                      && request.resource.data.studentId == studentId
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 40
                      && request.resource.data.answers is list
                      && request.resource.data.submittedAt is number;
        allow update, delete: if false; // immutable once submitted
      }
    }

    // Teacher-owned saved quizzes (future library sync beyond local storage).
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
