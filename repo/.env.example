# ─────────────────────────────────────────────────────────────────────────────
# GroundEd — environment configuration
#
# Copy this file to `.env.local` and fill in the values from YOUR Firebase
# project (see FIREBASE_SETUP.md). With no values set, the app runs in
# clearly-labelled DEMO mode with a local simulation engine.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase web app config (Project settings → General → Your apps → SDK setup)
# These values identify your project — they are NOT secrets. Security comes
# from App Check + Firestore rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (REQUIRED for Firebase AI Logic)
# Production: create a reCAPTCHA v3 site key (https://www.google.com/recaptcha/admin)
# and register it in Firebase console → App Check → Apps → your web app.
NEXT_PUBLIC_APPCHECK_RECAPTCHA_SITE_KEY=
# Local development alternative: a debug token registered in
# Firebase console → App Check → Manage debug tokens. Leave empty on first run,
# open DevTools, copy the printed "AppCheck debug token", register it, paste here.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
